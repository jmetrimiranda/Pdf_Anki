{
  "name": "@leitor/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "pnpm lint && vite build",
    "build:mock": "vite build --mode mock",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:mock": "playwright test --project=chromium --project=webkit",
    "e2e:bridge": "playwright test --project=bridge-chromium --project=bridge-webkit",
    "e2e:perf": "LEITOR_PERF=1 playwright test --project=perf-chromium --project=perf-webkit --workers=1",
    "e2e:load": "LEITOR_LOAD=1 playwright test --project=load-chromium --project=load-webkit --workers=1",
    "lint": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "tauri": "tauri",
    "format": "prettier --write src e2e *.ts",
    "format:check": "prettier --check src e2e *.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@leitor/checkers": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
