# Copy to .env (chmod 600) in /opt/leitor-sync/infra/sync-server and fill it with ./set-secret.sh — never paste a
# secret in a chat, a commit or a log. See README.md.

# Public hostnames (Cloudflare routes → http://caddy).
ANKI_HOST=anki.jmetrimirandai.com
LIBRARY_HOST=leitor-sync.jmetrimirandai.com

# Anki sync account (the same user/password in the Leitor and in Anki/AnkiMobile).
ANKI_SYNC_USER=jorge
ANKI_SYNC_PASSWORD=

# Library login (each device gets its own revocable token from it).
LIBRARY_SYNC_USER=jorge
LIBRARY_SYNC_PASSWORD=

# Token of the Cloudflare tunnel "leitor".
CLOUDFLARE_TUNNEL_TOKEN=

# Written by deploy.sh: the version that is up.
LEITOR_SYNC_VERSION=local
