{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leitor de Estudos",
  "version": "0.1.0",
  "identifier": "dev.jmetri.leitor-estudos",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @leitor/web dev",
    "beforeBuildCommand": "pnpm --filter @leitor/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Leitor de Estudos",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: pdf: http://pdf.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost pdf: http://pdf.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: pdf: http://pdf.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost pdf: http://pdf.localhost ws://localhost:5173 http://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"] }
}
