{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leitor de Estudos",
  "version": "0.1.0",
  "identifier": "dev.jmetri.leitor-estudos",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../web dev",
    "beforeBuildCommand": "pnpm --dir ../web build"
  },
  "app": {
    "windows": [{ "title": "Leitor de Estudos", "width": 1280, "height": 820, "minWidth": 720, "minHeight": 480 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
