{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leitor de Estudos",
  "version": "0.1.0",
  "identifier": "dev.jmetri.leitor-estudos",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @leitor/web dev",
    "beforeBuildCommand": "pnpm --filter @leitor/web exec bash ../scripts/build-pdfcraft-web.sh && pnpm --filter @leitor/web exec bash ../scripts/fetch-anki-web.sh && pnpm --filter @leitor/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Leitor de Estudos",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: pdf: http://pdf.localhost card: http://card.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost pdf: http://pdf.localhost data: blob:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' anki: http://anki.localhost card: http://card.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'self'",
        "media-src": "'self' card: http://card.localhost blob:"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: pdf: http://pdf.localhost card: http://card.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost pdf: http://pdf.localhost data: blob: ws://localhost:5173 http://localhost:5173",
        "worker-src": "'self' blob:",
        "frame-src": "'self' anki: http://anki.localhost card: http://card.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'self'",
        "media-src": "'self' card: http://card.localhost blob:"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF",
        "description": "Documento PDF",
        "role": "Viewer"
      },
      {
        "ext": [
          "apkg"
        ],
        "mimeType": "application/zip",
        "name": "Pacote do Anki",
        "description": "Pacote de deck do Anki",
        "role": "Viewer"
      },
      {
        "ext": [
          "colpkg"
        ],
        "mimeType": "application/zip",
        "name": "Coleção do Anki",
        "description": "Coleção completa do Anki",
        "role": "Viewer"
      }
    ],
    "resources": {
      "../resources/anki-web/": "anki-web/"
    }
  }
}
