    "html": "a<br/>b<br />c<BR>d",
    "readsAs": "a\nb\nc\nd"
  },
  {
    "name": "bold inside",
    "html": "<b>sudo</b> apt <i>install</i> x",
    "readsAs": "sudo apt install x"
  },
  {
    "name": "numeric entities",
    "html": "&#60;tag&#x3E; &#X41;",
    "readsAs": "<tag> A"
  },
  {
    "name": "one pass unescape",
    "html": "&amp;lt;",
    "readsAs": "&lt;"
  },
  {
    "name": "unknown entity kept",
    "html": "&foo; &#0; &",
    "readsAs": "&foo; &#0; &"
  },
  {
    "name": "paragraphs",
    "html": "<p>one</p><p>two</p>",
    "readsAs": "one\ntwo"
  },
  {
    "name": "span with attributes",
    "html": "<span style=\"color: red\">x</span>&gt;y",
    "readsAs": "x>y"
  },
